{
  "name": "cli-template-manager",
  "version": "2.0.0",
  "description": "A CLI tool for initializing and managing project templates with versioning, variables and marketplace support",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.mts",
        "default": "./dist/cli.mjs"
      },
      "require": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.cjs"
      }
    }
  },
  "bin": {
    "ctm": "./dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "npm run clean && tsup",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "dev": "tsup --watch",
    "start": "node ./dist/index.cjs",
    "start:esm": "node ./dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run typecheck && npm run lint:check && npm run test && npm run build",
    "precommit": "lint-staged",
    "commitlint": "commitlint --edit"
  },
  "keywords": [
    "cli",
    "template",
    "scaffold",
    "project-generator",
    "typescript",
    "commander",
    "inquirer"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^10.0.1",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/ora": "^3.2.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.8.4",
    "rimraf": "^5.0.7",
    "tsup": "^8.1.0",
    "typescript": "^5.3.2",
    "vitest": "^1.6.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,js,json,md}": [
      "prettier --write"
    ]
  }
}
